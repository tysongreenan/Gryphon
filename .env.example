# Gryphon Environment Variables

# Application
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string

# Database
DATABASE_URL=sqlite+aiosqlite:///./gryphon.db
# Later: postgresql+asyncpg://user:pass@localhost/gryphon

# Browserbase (primary session provider)
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# Notifications
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
# Default channel or user to notify for escalations
SLACK_DEFAULT_CHANNEL=

# Email (optional for MVP)
RESEND_API_KEY=
EMAIL_FROM=auth@gryphon.dev

# API
API_HOST=0.0.0.0
API_PORT=8000
