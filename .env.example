# Gryphon Environment Variables
# Copy to repo root `.env` or `apps/api/.env`

# Application
ENVIRONMENT=development
DEBUG=true
# Used to HMAC API keys and sign human-resolve links — change in any shared environment
SECRET_KEY=change-me-to-a-long-random-string

# Database (default: SQLite file under apps/api/gryphon.db)
# DATABASE_URL=sqlite+aiosqlite:///./gryphon.db
# Later: postgresql+asyncpg://user:pass@localhost/gryphon

# Bootstrap API key — seeded into the DB on startup as user DEFAULT_USER_ID
# Send as X-API-Key on agent/API requests
GRYPHON_API_KEY=dev-api-key
DEFAULT_USER_ID=user_dev

# Public URL used in Slack resolve links (must be reachable by the human's browser)
PUBLIC_BASE_URL=http://localhost:8000

# Escalation reliability
ESCALATION_TTL_SECONDS=86400
RESOLVE_TOKEN_TTL_SECONDS=3600

# Browserbase (Phase 2 — contexts + sessions + live view)
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
# true = in-memory fake client (local demos/tests without a Browserbase account)
BROWSERBASE_USE_FAKE=true
BROWSERBASE_HUMAN_SESSION_TIMEOUT=900
BROWSERBASE_AGENT_SESSION_TIMEOUT=600

# Notifications — leave blank to log notifications instead of posting to Slack
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_DEFAULT_CHANNEL=

# Email (optional for MVP)
RESEND_API_KEY=
EMAIL_FROM=auth@gryphon.dev

# API
API_HOST=0.0.0.0
API_PORT=8000
