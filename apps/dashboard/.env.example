# Waitlist storage — configure at least one for production (Vercel env)

# Option A: Supabase (run supabase/waitlist.sql first)
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# WAITLIST_TABLE=waitlist_signups

# Option B: generic webhook
# WAITLIST_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/...

# Local: leave both unset → signups append to .data/waitlist.jsonl
